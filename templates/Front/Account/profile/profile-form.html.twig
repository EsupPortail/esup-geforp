            {{ form_widget(form.bap, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.corps, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
        <div class="col-sm-10">
            {{ form_widget(form.corps, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="form-group">
        {{ form_label(form.category, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
        <div class="col-sm-10">
            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    {% if etablissement == "AMU" %}
        <div class="form-group">
            {{ form_label(form.campus, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.campus, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    {% else %}
        <div style="display:none">
            <div class="form-group">
                {{ form_label(form.campus, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
                <div class="col-sm-10">
                    {{ form_widget(form.campus, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        </div>
    {% endif %}
    <div class="form-group">
    {{ form_label(form.fonction, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
        <div class="col-sm-10">
            {{ form_widget(form.fonction, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <br>
    <h2> Responsable hiérarchique <img class="glyphicon glyphicon-question-sign" title="Si vous êtes personnel BIATSS (titulaire ou non titulaire) : 
- vous devez saisir obligatoirement ici les coordonnées de votre responsable hiérarchique qui validera votre inscription

Si vous êtes enseignant, enseignant-chercheur, doctorant contractuel (démarche facultative) : 
- vous pouvez saisir les coordonnées d'une personne à informer de votre inscription en formation : directeur de composante (ou de département d'enseignement), directeur de laboratoire, directeur de thèse.   "
                                       src="{{ asset('img/help.png') }}" height="30" alt="Aide"/>
    </h2>
    {% if flagAMU == 1 %}
        <div class="form-group">
        {{ form_label(form.lastnamesup, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.lastnamesup, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    <div class="form-group">
        {{ form_label(form.firstnamesup, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
        <div class="col-sm-10">
            {{ form_widget(form.firstnamesup, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
        <div class="form-group">
            {{ form_label(form.emailsup, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.emailsup, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    {% else %}
        <div class="form-group">
            {{ form_label(form.lastnamesup, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.lastnamesup, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.firstnamesup, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.firstnamesup, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.emailsup, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.emailsup, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    {% endif %}
    <br>

    {% if activeCorrForm == 0 %}
        <div style="display:none">
            <div class="form-group">
                {{ form_label(form.lastnamecorr, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
                <div class="col-sm-10">
                    {{ form_widget(form.lastnamecorr, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="form-group">
                {{ form_label(form.firstnamecorr, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
                <div class="col-sm-10">
                    {{ form_widget(form.firstnamecorr, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
            <div class="form-group">
            {{ form_label(form.emailcorr, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
                <div class="col-sm-10">
                    {{ form_widget(form.emailcorr, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>
        </div>
    {% else %}
        <h2> Correspondant formation <img class="glyphicon glyphicon-question-sign"
                                          title="Vous pouvez saisir ici, s’il y a lieu, les coordonnées du correspondant formation de votre laboratoire, composante / département d‘enseignement ou service (si celui-ci souhaite être en copie des mails de suivi de vos inscriptions en formation)."
                                          src="{{ asset('img/help.png') }}" height="30" alt="Aide"/>
        </h2>
        <div class="form-group">
        {{ form_label(form.lastnamecorr, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.lastnamecorr, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.firstnamecorr, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.firstnamecorr, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
        <div class="form-group">
            {{ form_label(form.emailcorr, null, {'label_attr': {'class': 'col-sm-2 control-label'}}) }}
            <div class="col-sm-10">
                {{ form_widget(form.emailcorr, {'attr': {'class': 'form-control'}}) }}
            </div>
        </div>
    {% endif %}
</section>
<section>
    <div class="row">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary btn-block">Enregistrer</button>
        </div>
    </div>
</section>
{{ form_end(form) }}